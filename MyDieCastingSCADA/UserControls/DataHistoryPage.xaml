<UserControl x:Class="MyDieCastingSCADA.UserControls.DataHistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,10">
   <StackPanel>
    <TextBlock Text="运行数据存储" FontSize="25" FontWeight="Bold"/>
    <TextBlock x:Name="DatabaseStatus" Foreground="#777" TextWrapping="Wrap" Margin="0,3,150,0"/>
   </StackPanel>
   <Button x:Name="TestSqlButton" Content="测试 SQL Server" Width="130" Height="32" HorizontalAlignment="Right" Click="TestSqlServer_Click"/>
  </Grid>
  <WrapPanel Grid.Row="1" Margin="0,0,0,10" VerticalAlignment="Center">
   <TextBlock Text="开始日期：" VerticalAlignment="Center"/>
   <DatePicker x:Name="StartDatePicker" Width="135" SelectedDateFormat="Short"/>
   <TextBlock Text="结束日期：" Margin="14,0,0,0" VerticalAlignment="Center"/>
   <DatePicker x:Name="EndDatePicker" Width="135" SelectedDateFormat="Short"/>
   <TextBlock Text="最多显示：" Margin="14,0,0,0" VerticalAlignment="Center"/>
   <ComboBox x:Name="CountBox" Width="85" SelectedIndex="1">
    <ComboBoxItem Content="100"/><ComboBoxItem Content="200"/><ComboBoxItem Content="500"/><ComboBoxItem Content="1000"/>
   </ComboBox>
   <Button Content="查询" Width="80" Height="30" Margin="14,0,0,0" Click="Refresh_Click"/>
   <Button Content="今天" Width="80" Height="30" Margin="8,0,0,0" Click="Today_Click"/>
   <TextBlock x:Name="QueryStatus" Margin="14,0,0,0" Foreground="#777" VerticalAlignment="Center"/>
  </WrapPanel>
  <DataGrid Grid.Row="2" ItemsSource="{Binding Samples}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" FrozenColumnCount="2">
   <DataGrid.Columns>
    <DataGridTextColumn Header="采样时间" Binding="{Binding SampleTimeText}" Width="160"/>
    <DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" Width="130"/>
    <DataGridTextColumn Header="压铸周期ID" Binding="{Binding CycleIdText}" Width="230"/>
    <DataGridTextColumn Header="压力" Binding="{Binding ActualPressure,StringFormat=F1}" Width="80"/>
    <DataGridTextColumn Header="剩余铝液" Binding="{Binding ResidualAluminium,StringFormat=F1}" Width="90"/>
    <DataGridTextColumn Header="铝液实际温度" Binding="{Binding AluminiumTemperature,StringFormat=F1}" Width="110"/>
    <DataGridTextColumn Header="铝液设定温度" Binding="{Binding SetAluminiumTemperature,StringFormat=F1}" Width="110"/>
    <DataGridTextColumn Header="实际炉温" Binding="{Binding FurnaceTemperature,StringFormat=F1}" Width="90"/>
    <DataGridTextColumn Header="设定炉温" Binding="{Binding SetFurnaceTemperature,StringFormat=F1}" Width="90"/>
    <DataGridTextColumn Header="模具温度(JSON)" Binding="{Binding TemperaturesJson}" Width="220"/>
    <DataGridTextColumn Header="冷却实际流量(JSON)" Binding="{Binding CoolingActualFlowsJson}" Width="240"/>
    <DataGridTextColumn Header="冷却设定流量(JSON)" Binding="{Binding CoolingSetFlowsJson}" Width="240"/>
    <DataGridTextColumn Header="完整配置点位快照(JSON)" Binding="{Binding FullSnapshotJson}" Width="320"/>
   </DataGrid.Columns>
  </DataGrid>
 </Grid>
</UserControl>
