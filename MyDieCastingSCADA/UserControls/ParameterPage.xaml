<UserControl x:Class="MyDieCastingSCADA.UserControls.ParameterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="684" d:DesignWidth="1380">
    <Viewbox Stretch="Uniform">
        <Border CornerRadius="10" Background="White" Width="1380" Height="684" 
                BorderBrush="#e0e0e0" BorderThickness="1">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="120" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,6,0">
                    <Border Background="#f8f9fa" CornerRadius="5" Padding="4" Margin="0,0,0,12" Width="90">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="冷却通道" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="风/水" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="时间/温度" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Text="通道热电偶" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Text="流量设定" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="5" Text="设定温度" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="6" Text="延迟时间" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="7" Text="开启时长" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="8" Text="交叉时间" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="9" Text="状态" FontSize="15" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Background="#f8f9fa" CornerRadius="5" Padding="4" Width="90">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="冷却通道" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="风/水" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="时间/温度" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Text="通道热电偶" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Text="流量设定" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="5" Text="设定温度" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="6" Text="延迟时间" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="7" Text="开启时长" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="8" Text="交叉时间" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="9" Text="状态" FontSize="15" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <ScrollViewer Grid.Column="1" Grid.Row="0"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto"
              Margin="0,0,0,0">
                    <ItemsControl ItemsSource="{Binding EditableChannels}" Height="Auto">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="12" Rows="2" HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="1" Padding="2" Background="#f0f4f8" CornerRadius="6"
                        BorderBrush="#ccc" BorderThickness="1" Width="105" Height="260" VerticalAlignment="Top">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="26"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Text="{Binding Channel, StringFormat='通道 {0:D2}'}"
                                   FontWeight="Bold" HorizontalAlignment="Center" FontSize="14"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Air"
                                   FontSize="12" Foreground="#3498db" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Water"
                                   FontSize="12" Foreground="#2e7d32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="2" Grid.Column="0" 
          SelectedIndex="{Binding AirConMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          FontSize="13" Height="25" Margin="2">
                                            <ComboBoxItem Content="时间"/>
                                            <ComboBoxItem Content="温度"/>
                                        </ComboBox>
                                        <ComboBox Grid.Row="2" Grid.Column="1" 
          SelectedIndex="{Binding WaterConMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          FontSize="13" Height="25" Margin="2">
                                            <ComboBoxItem Content="时间"/>
                                            <ComboBoxItem Content="温度"/>
                                        </ComboBox>
                                        <ComboBox Grid.Row="3" Grid.Column="0" 
          SelectedIndex="{Binding AirTheNm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          FontSize="13" Height="25" Margin="2">
                                            <ComboBoxItem Content="TC01"/>
                                            <ComboBoxItem Content="TC02"/>
                                            <ComboBoxItem Content="TC03"/>
                                            <ComboBoxItem Content="无"/>
                                        </ComboBox>
                                        <ComboBox Grid.Row="3" Grid.Column="1" 
          SelectedIndex="{Binding WaterTheNm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          FontSize="13" Height="25" Margin="2">
                                            <ComboBoxItem Content="TC01"/>
                                            <ComboBoxItem Content="TC02"/>
                                            <ComboBoxItem Content="TC03"/>
                                            <ComboBoxItem Content="无"/>
                                        </ComboBox>
                                        <TextBox Grid.Row="4" Grid.Column="0" Text="{Binding AirFlow}"
                                 FontSize="13" Height="25" Margin="2" HorizontalContentAlignment="Center"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding WaterFlow}"
                                 FontSize="13" Height="25" Margin="2" HorizontalContentAlignment="Center"/>
                                        <TextBox Grid.Row="5" Grid.Column="0" Text="{Binding AirSetTemp}"
                                 FontSize="13" Height="25" Margin="2" HorizontalContentAlignment="Center"/>
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding WaterSetTemp}"
                                 FontSize="13" Height="25" Margin="2" HorizontalContentAlignment="Center"/>
                                        <TextBox Grid.Row="6" Grid.Column="0" Text="{Binding AirLastTime}"
                                 FontSize="13" Height="25" Margin="2" HorizontalContentAlignment="Center"/>
                                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding WaterLastTime}"
                                 FontSize="13" Height="25" Margin="2" HorizontalContentAlignment="Center"/>
                                        <TextBox Grid.Row="7" Grid.Column="0" Text="{Binding AirOpenTime}"
                                 FontSize="13" Height="25" Margin="2" HorizontalContentAlignment="Center"/>
                                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding WaterOpenTime}"
                                 FontSize="13" Height="25" Margin="2" HorizontalContentAlignment="Center"/>
                                        <TextBox Grid.Row="8" Grid.Column="0" Text="{Binding AirCrossTime}"
                                FontSize="13" Height="25" Margin="2" HorizontalContentAlignment="Center"/>
                                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding WaterCrossTime}"
                                FontSize="13" Height="25" Margin="2" HorizontalContentAlignment="Center"/>
                                        <Border Grid.Row="9" Grid.Column="0" Background="#27AE60"
                                CornerRadius="13" Height="26" Width="24" Margin="2"
                                HorizontalAlignment="Center" BorderBrush="#666" BorderThickness="2">
                                            <Ellipse Width="16" Height="16" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Row="9" Grid.Column="1"
                                Content="OK" FontSize="12" Height="24" Margin="2"
                                Background="#3498db" Foreground="White"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0"
                                Tag="{Binding}" Click="ChannelOK_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
        Background="#f8f9fa" CornerRadius="8"
        Margin="0,3,0,0" Padding="6,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="269"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,56,0">
                            <TextBlock Text="开模控制" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" Width="82" HorizontalAlignment="Left"/>
                            <Grid Height="80" Width="224">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="开模方式：" VerticalAlignment="Center" Margin="0,4,8,4" HorizontalAlignment="Right"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" 
                  SelectedIndex="{Binding EditableCastingOpenMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Width="110" Height="20" FontSize="14">
                                    <ComboBoxItem Content="时间"/>
                                    <ComboBoxItem Content="温度"/>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="开模温度：" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <TextBox Grid.Row="1" Grid.Column="1" 
                 Text="{Binding EditableCastingOpenTemp, StringFormat={}{0:F1}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Width="110" Height="20" FontSize="14" HorizontalContentAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="开模热偶：" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" 
                  SelectedIndex="{Binding EditableCastingOpenThermo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Width="110" Height="20" FontSize="14">
                                    <ComboBoxItem Content="TC01"/>
                                    <ComboBoxItem Content="TC02"/>
                                    <ComboBoxItem Content="TC03"/>
                                    <ComboBoxItem Content="TC04"/>
                                </ComboBox>
                            </Grid>
                            <Button Content="下载开模参数" Width="110" Height="28" Margin="0,4,0,0"
            Background="#9b59b6" Foreground="White" FontSize="12"
            Click="BtnDownloadOpenParam_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock Text="保压 &amp; 冷却时间" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid Width="194" Height="70">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="保压时间：" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <TextBox Grid.Row="0" Grid.Column="1" 
                 Text="{Binding EditableMaintainTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Width="110" Height="20" FontSize="14" HorizontalContentAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="冷却 Max：" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <TextBox Grid.Row="1" Grid.Column="1" 
                 Text="{Binding EditableCoolingTimeMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Width="110" Height="20" FontSize="14" HorizontalContentAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="冷却 Min：" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <TextBox Grid.Row="2" Grid.Column="1" 
                 Text="{Binding EditableCoolingTimeMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Width="110" Height="20" FontSize="14" HorizontalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Height="109">
                            <TextBlock Text="工艺文件" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2" Height="19" HorizontalAlignment="Left" Width="58"/>
                            <ComboBox x:Name="cbRecipes" Width="528" Height="34" FontSize="14" Margin="0,0,0,12" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="加载工艺" Width="100" Height="42" Margin="0,0,8,0"
                        Background="#f39c12" Foreground="White" Click="BtnLoadRecipe_Click"/>
                                <Button Content="保存工艺" Width="100" Height="42" Margin="0,0,8,0"
                        Background="#27ae60" Foreground="White" Click="BtnSaveRecipe_Click"/>
                                <Button Content="全部下发" Width="110" Height="42"
                        Background="#e74c3c" Foreground="White" Click="BtnDownloadAll_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="OK" 
                Width="39" Height="24"
                Background="#8e44ad" Foreground="White" FontSize="12"
                Click="BtnDownloadOpenParam_Click"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="200,79,0,0" RenderTransformOrigin="1.274,0.556"/>
                        <Button Content="OK" 
                        Width="39" Height="24"
                    Background="#8e44ad" Foreground="White" FontSize="12"
                    Click="BtnDownloadMaintainCoolTime_Click"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="246,79,0,0" RenderTransformOrigin="1.274,0.556" Grid.Column="1" Grid.ColumnSpan="2"/>
                   </Grid>
                </Border>
            </Grid>
        </Border>
    </Viewbox>
</UserControl>