<UserControl x:Class="MyDieCastingSCADA.UserControls.TrendPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="实时趋势" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="勾选需要观察的数据；左轴显示温度，右轴显示压力，刻度自动调整"
                       Margin="0,3,0,0" Foreground="#777" FontSize="13"/>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,0,0,10" Padding="10,7"
                Background="#F6F7FA" BorderBrush="#E3E6EC" BorderThickness="1"
                CornerRadius="5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="全选" Click="SelectAll_Click" Padding="12,3" Margin="0,0,6,0"/>
                    <Button Content="清空" Click="ClearAll_Click" Padding="12,3"/>
                </StackPanel>
                <WrapPanel x:Name="SeriesSelector" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" BorderBrush="#D9DDE5" BorderThickness="1" Background="White">
            <Grid>
                <Canvas x:Name="Chart" SizeChanged="Chart_SizeChanged" ClipToBounds="True"/>
                <TextBlock x:Name="ChartMessage" Text="请选择至少一个温度点"
                           Foreground="#999" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
