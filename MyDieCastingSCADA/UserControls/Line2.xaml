<UserControl 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    x:Class="MyDieCastingSCADA.UserControls.Line2"
    d:DesignHeight="600" 
    d:DesignWidth="1100">
    <UserControl.Resources>
        <Style x:Key="PlcButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6a5dae"/>
            <Setter Property="Foreground" Value="#f0eff6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="20"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8276c0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border CornerRadius="20" Background="#54479c" Margin="0 0 10 20">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Line 2 - PLC 设备列表" 
                       Foreground="#f0eff6" 
                       FontSize="18" 
                       FontWeight="SemiBold" 
                       Margin="0 0 0 20"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <WrapPanel ItemWidth="220" ItemHeight="160" Margin="0 10 0 0">
                    <Button Width="200" Height="140" Margin="12" 
                            Style="{StaticResource PlcButtonStyle}"
                            Click="PlcButton_Click"
                            Tag="LINE2_PLC01">
                        <StackPanel VerticalAlignment="Center">
                            <Icon:PackIconMaterial Kind="RobotIndustrial" Width="48" Height="48" HorizontalAlignment="Center"/>
                            <TextBlock Text="PLC-01&#xA;压铸机 A" 
                                       FontSize="16" FontWeight="SemiBold" 
                                       TextAlignment="Center" Margin="0 8 0 0"/>
                            <TextBlock Text="192.168.1.101" 
                                       FontSize="13" Opacity="0.8" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Width="200" Height="140" Margin="12" 
                            Style="{StaticResource PlcButtonStyle}"
                            Click="PlcButton_Click"
                            Tag="LINE2_PLC02">
                        <StackPanel VerticalAlignment="Center">
                            <Icon:PackIconMaterial Kind="RobotIndustrial" Width="48" Height="48" HorizontalAlignment="Center"/>
                            <TextBlock Text="PLC-02&#xA;压铸机 B" 
                                       FontSize="16" FontWeight="SemiBold" 
                                       TextAlignment="Center" Margin="0 8 0 0"/>
                            <TextBlock Text="192.168.1.102" 
                                       FontSize="13" Opacity="0.8" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>