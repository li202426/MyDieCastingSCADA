<UserControl x:Class="MyDieCastingSCADA.UserControls.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="604" d:DesignWidth="1220">
    <Viewbox Stretch="Uniform" Margin="0,0,0,0">
        <Border CornerRadius="20" Background="White" Width="1220" Height="604" BorderBrush="#e0e0e0" BorderThickness="1">
            <Grid Margin="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding CoolingChannelRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="210" Margin="8" Padding="6"
                                                Background="#f3f4f6" CornerRadius="10"
                                                BorderBrush="#ddd" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="28"/>
                                                    <RowDefinition Height="18"/>
                                                    <RowDefinition Height="20"/>
                                                    <RowDefinition Height="20"/>
                                                    <RowDefinition Height="20"/>
                                                    <RowDefinition Height="20"/>
                                                    <RowDefinition Height="20"/>
                                                    <RowDefinition Height="20"/>
                                                    <RowDefinition Height="20"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="数值含义" FontSize="13" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="2" Text="自动模式" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="3" Text="热电偶号" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="4" Text="设定温度" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="5" Text="控制模式" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="6" Text="延迟时间" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="7" Text="开启时长" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="8" Text="交叉时间" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding CoolingChannels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="210" Margin="8" Padding="6" Background="#f8f9fa" CornerRadius="10" BorderBrush="#ddd" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="18"/>
                                                <RowDefinition Height="20"/>
                                                <RowDefinition Height="20"/>
                                                <RowDefinition Height="20"/>
                                                <RowDefinition Height="20"/>
                                                <RowDefinition Height="20"/>
                                                <RowDefinition Height="20"/>
                                                <RowDefinition Height="20"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                                       Text="{Binding Channel, StringFormat=冷却通道{0:D2}}"
                                                       FontSize="15" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Air" FontSize="12" Foreground="#3498db" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Water" FontSize="12" Foreground="#2e7d32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding AirAuMode}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding AirTheNm}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding AirTemp, StringFormat={}{0:F0}}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding AirConMode}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding AirDelayTime}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding AirOpenTime}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding AirCrossTime}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WaterAuMode}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WaterTheNm}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding WaterTemp, StringFormat={}{0:F0}}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding WaterConMode}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding WaterDelayTime}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding WaterOpenTime}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding WaterCrossTime}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Border Background="#f0f0f0"  CornerRadius="8"  Padding="12"  Margin="0,0,0,15"  Height="384">
                            <Grid Margin="0,-2,0,0" Width="180">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="1"  Text="压力值"  FontSize="16"  FontWeight="Bold"  HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="2"  Text="时间"  FontSize="16"  FontWeight="Bold"  HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                                <ItemsControl Grid.Row="1"   Grid.Column="0"  Grid.ColumnSpan="2" ItemsSource="{Binding PressureItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Stage}"  FontSize="16"  FontWeight="Bold"  HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"  Text="{Binding Value, StringFormat={}{0:F0}}" 
                                                            FontSize="24"   FontWeight="Bold"  Foreground="#e74c3c"  HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl Grid.Row="1" 
                                        Grid.Column="2"
                                    ItemsSource="{Binding TimeItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="3.2" 
                            CornerRadius="4" 
                            Height="30">
                                                <TextBlock Text="{Binding Value}" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#2ecc71" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        <Border Background="#f0f0f0" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="其他工艺参数" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="冷却时间 Max：" FontSize="14" Margin="0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CoolingTimeMaxItem.Value}" FontSize="16" FontWeight="Bold" Foreground="#e74c3c"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="冷却时间 Min：" FontSize="14" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CoolingTimeMinItem.Value}" FontSize="16" FontWeight="Bold" Foreground="#e74c3c"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="开模温度：" FontSize="14" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CastingOpenTempItem.Value, StringFormat={}{0:F1}}" FontSize="16" FontWeight="Bold" Foreground="#3498db"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="开模方式：" FontSize="14" Margin="0,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CastingOpenModeItem.Value}" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="开模热偶：" FontSize="14" Margin="0,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CastingOpenThermoItem.Value}" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MoldName}" FontSize="16" FontWeight="Bold" Foreground="#2ecc71" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Viewbox>
</UserControl>
