<UserControl x:Class="MyDieCastingSCADA.UserControls.AlarmPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,10"><TextBlock Text="报警记录" FontSize="25" FontWeight="Bold"/><Button Content="确认选中报警" HorizontalAlignment="Right" Width="130" Click="Acknowledge_Click"/></Grid>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
   <TextBlock Text="状态：" VerticalAlignment="Center"/><ComboBox x:Name="StatusFilter" Width="130" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem Content="全部状态"/><ComboBoxItem Content="活动报警"/><ComboBoxItem Content="已恢复"/><ComboBoxItem Content="未确认"/></ComboBox>
   <TextBlock Text="等级：" Margin="18,0,0,0" VerticalAlignment="Center"/><ComboBox x:Name="LevelFilter" Width="120" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem Content="全部等级"/><ComboBoxItem Content="严重"/><ComboBoxItem Content="警告"/></ComboBox>
   <TextBlock Text="关键字：" Margin="18,0,0,0" VerticalAlignment="Center"/><TextBox x:Name="KeywordBox" Width="220" TextChanged="FilterChanged"/>
  </StackPanel>
  <DataGrid x:Name="AlarmGrid" Grid.Row="2" ItemsSource="{Binding AlarmView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="发生时间" Binding="{Binding OccurredAtText}" Width="150"/><DataGridTextColumn Header="恢复时间" Binding="{Binding RecoveredAtText}" Width="150"/><DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="70"/><DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="110"/><DataGridTextColumn Header="报警内容" Binding="{Binding Message}" Width="250"/><DataGridTextColumn Header="当前值/问题" Binding="{Binding CurrentValue}" Width="*"/></DataGrid.Columns></DataGrid>
 </Grid>
</UserControl>
