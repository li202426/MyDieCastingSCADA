<UserControl x:Class="MyDieCastingSCADA.UserControls.TemperaturePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White"
             >
    <Viewbox Stretch="Uniform" Margin="0">
        <Border CornerRadius="20" Background="White" Width="1220" Height="604">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="141*"/>
                    <RowDefinition Height="463*"/>
                </Grid.RowDefinitions>
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding Temperatures}"
                              Margin="438,6,6,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="10" Rows="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Padding="8,5" Background="#f8f9fa" CornerRadius="8" Height="52">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="14" Foreground="#666"/>
                                    <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold" Foreground="#e74c3c"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Margin="310,79,825,0" 
                    Padding="16,12" 
                    Background="#f8f9fa" 
                       CornerRadius="8" 
                    Height="47" 
                    VerticalAlignment="Top">
                    <Grid Margin="-16,-12,-16,-12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                   Text="{Binding ActualPressureItem.Label}" 
                   FontSize="14" 
                   Foreground="#666" 
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1"
                   Text="{Binding ActualPressureItem.Value}" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#4A25DA" 
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
                <Border Margin="305,6,825,0" Padding="12" Background="#f8f9fa" CornerRadius="8" Height="63" VerticalAlignment="Top">
                    <StackPanel Margin="-12,-12,-12,-8">
                        <TextBlock Text="{Binding AmountOfResidualAluminum.Label}" FontSize="14" Foreground="#666" Height="19" Width="66"/>
                        <TextBlock Text="{Binding AmountOfResidualAluminum.Value}" FontSize="26" FontWeight="Bold" Foreground="#e74c3c" Width="71" RenderTransformOrigin="-0.014,0.649" Height="27"/>
                    </StackPanel>
                </Border>
                <Border Margin="10,74,1140,0" Padding="12" Background="#f8f9fa" CornerRadius="8" Height="57" VerticalAlignment="Top">
                    <StackPanel Margin="-12,-12,-12,-2">
                        <TextBlock Text="{Binding ActualAluminiumTemperature.Label}" FontSize="14" Foreground="#666" Height="19" RenderTransformOrigin="0.5,0.5" Width="60">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="{Binding ActualAluminiumTemperature.Value}" FontSize="26" FontWeight="Bold" Foreground="#e74c3c" Width="54" RenderTransformOrigin="-0.014,0.649" Height="32"/>
                    </StackPanel>
                </Border>
                <Border Margin="85,74,1065,0" Padding="12" Background="#f8f9fa" CornerRadius="8" Height="57" VerticalAlignment="Top">
                    <StackPanel Margin="-12,-12,-12,-2">
                        <TextBlock Text="{Binding SetAluminiumTemperature.Label}" FontSize="14" Foreground="#666" Height="19" RenderTransformOrigin="0.5,0.5" Width="59">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="{Binding SetAluminiumTemperature.Value}" FontSize="26" FontWeight="Bold" Foreground="#e74c3c" Width="54" RenderTransformOrigin="-0.014,0.649" Height="32"/>
                    </StackPanel>
                </Border>
                <Border Margin="160,74,990,0" Padding="12" Background="#f8f9fa" CornerRadius="8" Height="57" VerticalAlignment="Top">
                    <StackPanel Margin="-12,-12,-12,-2">
                        <TextBlock Text="{Binding ActualFurnaceTemperature.Label}" FontSize="14" Foreground="#666" Height="19" RenderTransformOrigin="0.5,0.5" Width="66">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="{Binding ActualFurnaceTemperature.Value}" FontSize="26" FontWeight="Bold" Foreground="#e74c3c" Width="54" RenderTransformOrigin="-0.014,0.649" Height="32"/>
                    </StackPanel>
                </Border>
                <Border Margin="235,74,915,0" Padding="12" Background="#f8f9fa" CornerRadius="8" Height="57" VerticalAlignment="Top">
                    <StackPanel Margin="-12,-12,-12,-2">
                        <TextBlock Text="{Binding SetFurnaceTemperature.Label}" FontSize="14" Foreground="#666" Height="19" RenderTransformOrigin="0.5,0.5" Width="66">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="{Binding SetFurnaceTemperature.Value}" FontSize="26" FontWeight="Bold" Foreground="#e74c3c" Width="54" RenderTransformOrigin="-0.014,0.649" Height="32"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" 
        Background="#f8f9fa" 
        Margin="10,15,20,15" 
        CornerRadius="12"
        Padding="15">
                    <Grid>
                        <Grid Width="140" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="通道" 
                       Grid.Row="0"
                       FontSize="15" FontWeight="Bold" 
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="风冷 (m³/h)" FontSize="14" FontWeight="SemiBold" Foreground="#3498db"/>
                                <TextBlock Text="设定          实际" FontSize="12" Foreground="#666" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="水冷 (L/min)" FontSize="14" FontWeight="SemiBold" Foreground="#2e7d32"/>
                                <TextBlock Text="设定          实际" FontSize="12" Foreground="#666" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Margin="145,0,0,0" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CoolingChannels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="{Binding CoolingChannelsCount}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="6" 
                                Padding="10" 
                                Background="White" 
                                CornerRadius="10" 
                                Width="110"
                                BorderBrush="#e0e0e0" 
                                BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Channel}" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="#2c3e50" 
                                           Margin="0,0,0,12"/>
                                                <TextBlock Text="{Binding AirFlowSet}" 
                                           FontSize="17" FontWeight="Bold" Foreground="#3498db" 
                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding AirActual}" 
                                           FontSize="17" FontWeight="Bold" Foreground="#e74c3c" 
                                           HorizontalAlignment="Center" Margin="0,8,0,12"/>
                                                <TextBlock Text="{Binding WaterFlowSet, StringFormat={}{0:F1}}" 
                                           FontSize="17" FontWeight="Bold" Foreground="#2e7d32" 
                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding WaterActual}" 
                                           FontSize="17" FontWeight="Bold" Foreground="#e74c3c" 
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Viewbox>
</UserControl>