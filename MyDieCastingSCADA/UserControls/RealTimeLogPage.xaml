<UserControl x:Class="MyDieCastingSCADA.UserControls.RealTimeLogPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><StackPanel><TextBlock Text="实时日志" FontSize="26" FontWeight="Bold"/><TextBlock Text="实时显示并按日期保存到 Logs 文件夹" Foreground="#777"/></StackPanel><Button Content="清空当前显示" Width="120" HorizontalAlignment="Right" Click="ClearLog_Click"/></Grid>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="日期：" VerticalAlignment="Center"/><DatePicker x:Name="DateFilter" Width="140" SelectedDateChanged="FilterChanged"/><TextBlock Text="等级：" Margin="18,0,0,0" VerticalAlignment="Center"/><ComboBox x:Name="LevelFilter" Width="120" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem Content="全部等级"/><ComboBoxItem Content="信息"/><ComboBoxItem Content="成功"/><ComboBoxItem Content="警告"/><ComboBoxItem Content="错误"/></ComboBox><TextBlock Text="关键字：" Margin="18,0,0,0" VerticalAlignment="Center"/><TextBox x:Name="KeywordBox" Width="250" TextChanged="FilterChanged"/><Button Content="重置" Margin="10,0,0,0" Width="70" Click="Reset_Click"/></StackPanel>
  <DataGrid Grid.Row="2" ItemsSource="{Binding LogView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" AlternatingRowBackground="#fafafa"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Foreground" Value="#333"/><Style.Triggers><DataTrigger Binding="{Binding Level}" Value="成功"><Setter Property="Foreground" Value="#16834b"/></DataTrigger><DataTrigger Binding="{Binding Level}" Value="警告"><Setter Property="Foreground" Value="#c06b00"/></DataTrigger><DataTrigger Binding="{Binding Level}" Value="错误"><Setter Property="Foreground" Value="#c62828"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="155"/><DataGridTextColumn Header="用户" Binding="{Binding UserName}" Width="90"/><DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="70"/><DataGridTextColumn Header="操作步骤" Binding="{Binding Operation}" Width="170"/><DataGridTextColumn Header="执行结果" Binding="{Binding Result}" Width="140"/><DataGridTextColumn Header="详细信息 / 问题" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid>
 </Grid>
</UserControl>
