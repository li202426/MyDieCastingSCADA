<Window x:Class="MyDieCastingSCADA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"       
        xmlns:Ivc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:uc="clr-namespace:MyDieCastingSCADA.UserControls"
        Height="760" Width="1280" Background="Transparent"  ResizeMode="CanResize"
        AllowsTransparency="True" WindowStyle="None" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Border Background="#cfd5e5" 
            CornerRadius="20" 
            BorderThickness="2" 
            BorderBrush="#ebedf3"
            Padding="10">
        <Border CornerRadius="20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#fefefe" Offset="0"/>
                    <GradientStop Color="#7163ba" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="20" Background="#7163ba" Margin="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" VerticalAlignment="Top">
                            <Button Style="{StaticResource topMenuButton}" Background="#FF9AA039">
                                <Icon:PackIconMaterial Kind="BellCheckOutline" Style="{StaticResource menuButtonIcon}"/>
                            </Button>
                            <Separator Background="#cc5" Margin="10 0 10 10" Height="40"/>
                            <Button x:Name="btnHome" Style="{StaticResource menuButton}" Background="#FF9184A4"
                                    Click="NavigationButton_Click" Tag="Dashboard">
                                <Icon:PackIconMaterial Kind="HomeVariant" Width="32" Height="32" Style="{StaticResource menuButtonIcon}"/>
                            </Button>
                            <Button x:Name="btnLine1" Style="{StaticResource menuButton}" Background="#FF456BC7"
                                    Click="NavigationButton_Click" Tag="Line1">
                                <Icon:PackIconMaterial Kind="RobotIndustrial" Width="32" Height="32" Style="{StaticResource menuButtonIcon}"/>
                            </Button>
                            <Button x:Name="btnLine2" Style="{StaticResource menuButton}" Background="#FF4E8E3D"
                                    Click="NavigationButton_Click" Tag="Line2">
                                <Icon:PackIconMaterial Kind="RobotIndustrial" Width="32" Height="32" Style="{StaticResource menuButtonIcon}"/>
                            </Button>
                        </StackPanel>
                        <Button Grid.Row="1" Style="{StaticResource menuButton}" Margin="0 20 0 30" Background="#FFD2492A"
                                Click="ExitButton_Click">
                            <Icon:PackIconMaterial Kind="Power" Width="32" Height="32"  Style="{StaticResource menuButtonIcon}"/>
                        </Button>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Margin="5 20 25 20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" 
                            Background="Transparent"
                            MouseDown="TitleBar_MouseDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="7 10 0 25" Grid.Column="0">
                                <TextBlock Text="Primary" Foreground="#797295" FontSize="13"/>
                                <TextBlock Text="Dashboard" Style="{StaticResource titleText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,15,0">
                                <TextBlock x:Name="txtLoggedUser" VerticalAlignment="Center" Foreground="#594e7f" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <Button Content="退出登录" Style="{StaticResource menuButton}" Width="112" FontSize="18" Height="46" Click="LogoutButton_Click" Background="#FF517DD4"/>
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Top" Margin="0 10 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0"/>
                                <Ellipse Margin="-876,-12,804,-11" Grid.Column="1">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/Images/P1.jpg"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Button x:Name="btnMaxRestore" 
                                        Grid.Column="2"
                                        Width="45" Height="45"
                                        Margin="0,0,0,0"
                                        Style="{StaticResource menuButton}"
                                        Click="MaxRestoreButton_Click" VerticalAlignment="Center">
                                    <Icon:PackIconMaterial x:Name="MaxIcon" 
                                                           Kind="WindowMaximize" 
                                                           Style="{StaticResource menuButtonIcon}" HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    <ContentControl x:Name="MainContent" 
                                    Grid.Row="1" 
                                    Grid.ColumnSpan="3"
                                    Margin="5 5 5 5" />
                </Grid>
                <ResizeGrip Grid.Column="1" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Bottom" 
                            Margin="0 0 30 30"
                            Width="24" Height="24" />
            </Grid>
        </Border>
    </Border>
</Window>
